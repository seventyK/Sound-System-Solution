
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="SoundSystemSolutionTest.PurchaseWizard"
        Title="Purchase Details - Step by Step"
        Width="800" Height="800"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Progress Indicator -->
        <Border Grid.Row="0" Background="#2E3440" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" x:Name="HeaderText" 
                          Text="Customer Information" 
                          FontSize="18" FontWeight="Bold" 
                          Foreground="White" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StepIndicator" Text="Step 1 of 4" 
                              Foreground="#81A1C1" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" Padding="40,30" Margin="0,0,0,10">
            <StackPanel x:Name="ContentPanel">
                
                <!-- Page 1: Customer Information -->
                <StackPanel x:Name="Page1" IsVisible="True">
                    <TextBlock Text="Please enter your customer information" 
                              FontSize="16" Margin="20,0,0,20" Foreground="#4C566A"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer ID:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <TextBox Grid.Row="0" Grid.Column="2" x:Name="CustomerIdTextBox" 
                                Watermark="Enter customer ID" Width="250" HorizontalAlignment="Left"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Full Name:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <TextBox Grid.Row="2" Grid.Column="2" x:Name="FullNameTextBox" 
                                Watermark="Enter full name" Width="250" HorizontalAlignment="Left"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Email:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <TextBox Grid.Row="4" Grid.Column="2" x:Name="EmailTextBox" 
                                Watermark="Enter email address" Width="250" HorizontalAlignment="Left"/>
                        
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Phone:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <TextBox Grid.Row="6" Grid.Column="2" x:Name="PhoneTextBox" 
                                Watermark="Enter phone number" Width="250" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
                
                <!-- Page 2: Payment Method -->
                <StackPanel x:Name="Page2" IsVisible="False">
                    <TextBlock Text="Select your payment method" 
                              FontSize="16" Margin="20,0,0,20" Foreground="#4C566A"/>
                    
                    <StackPanel Spacing="15">
                        <RadioButton x:Name="CashRadio" Content="Cash" GroupName="PaymentMethod" FontSize="14"
                                     Margin="30 0"/>
                        <RadioButton x:Name="CardRadio" Content="Credit/Debit Card" GroupName="PaymentMethod" FontSize="14" 
                                   IsEnabled="False" Foreground="Gray" Margin="30 0"/>
                        <RadioButton x:Name="BankTransferRadio" Content="Bank Transfer" GroupName="PaymentMethod" FontSize="14" 
                                   IsEnabled="False" Foreground="Gray" Margin="30 0"/>
                        <RadioButton x:Name="DigitalWalletRadio" Content="Digital Wallet" GroupName="PaymentMethod" FontSize="14" 
                                   IsEnabled="False" Foreground="Gray" Margin="30 0"/>
                    </StackPanel>
                    
                    <TextBlock Text="Payment Amount:" FontWeight="Bold" Margin="20,30,0,20"/>
                    <StackPanel>
                        <RadioButton x:Name="PayDepositRadio" 
                                     Content="Pay Deposit Only (50%)" GroupName="PaymentAmount" 
                                     VerticalAlignment="Center" Margin="30 5 0 0"/>
                        <RadioButton x:Name="PayFullRadio" 
                                     Content="Pay Full Amount" GroupName="PaymentAmount" 
                                     VerticalAlignment="Center" Margin="30 15"/>
                    </StackPanel>
                    
                    <StackPanel x:Name="CardDetailsPanel" IsVisible="False" Margin="0,30,0,0">
                        <TextBlock Text="Card Details:" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBox Grid.Row="0" Grid.Column="0" x:Name="CardNumberTextBox" 
                                    Watermark="Card Number"/>
                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="ExpiryTextBox" 
                                    Watermark="MM/YY"/>
                            <TextBox Grid.Row="2" Grid.Column="0" x:Name="CvvTextBox" 
                                    Watermark="CVV"/>
                            <TextBox Grid.Row="2" Grid.Column="2" x:Name="CardHolderTextBox" 
                                    Watermark="Cardholder Name"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                
                <!-- Page 3: Rental Details -->
                <StackPanel x:Name="Page3" IsVisible="False">
                    <TextBlock Text="Configure your rental details" 
                               FontSize="16" Margin="20,0,0,20" Foreground="#4C566A"/>
    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bundle ID:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <ComboBox Grid.Row="0" Grid.Column="2" x:Name="BundleComboBox" Width="250"
                                  HorizontalAlignment="Left"
                                  PlaceholderText="Select a bundle..." />
        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Rental Duration (days):" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="2" x:Name="RentalDurationUpDown" Width="250"
                                       HorizontalAlignment="Left"
                                       Minimum="1" Maximum="365" Value="1"/>
        
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Rental Start Date:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <CalendarDatePicker Grid.Row="4" Grid.Column="2" x:Name="RentDatePicker" Width="250"
                                    HorizontalAlignment="Left"/>
                        
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Venue:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <TextBox Grid.Row="6" Grid.Column="2" x:Name="VenueAddress" Width="250"
                                 HorizontalAlignment="Left"
                                 Watermark="Delivery address"/>
        
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Additional Notes:" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="30 0"/>
                        <TextBox Grid.Row="8" Grid.Column="2" x:Name="NotesTextBox" Width="250"
                                 HorizontalAlignment="Left"
                                 Watermark="Optional notes (delivery instructions, etc.)"/>
                    </Grid>
                </StackPanel>
                
                <!-- Page 4: Review and Confirm -->
                <StackPanel x:Name="Page4" IsVisible="False">
                    <TextBlock Text="Review your purchase details" 
                               FontSize="16" Margin="0,0,0,20" Foreground="#4C566A"/>
    
                    <Border Background="#F8F9FA" Padding="20" CornerRadius="8" BorderBrush="#E9ECEF" BorderThickness="1"
                            MaxHeight="400">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ReviewPanel" Spacing="10">
                                <!-- Review content will be populated programmatically -->
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
    
                    <CheckBox x:Name="TermsCheckBox" 
                              Content="I agree to the terms and conditions" 
                              Margin="0,30,0,20" FontSize="14"/>
                </StackPanel>

                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Navigation Buttons -->
        <Border Grid.Row="2" Background="#F8F9FA" Padding="40,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" x:Name="BackButton" 
                       Content="← Back" Width="100" Height="35"
                       HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                       IsEnabled="False" Click="BackButton_Click"/>
                
                <Button Grid.Column="2" x:Name="NextButton" 
                       Content="Next →" Width="100" Height="35"
                       Background="#5E81AC" Foreground="White"
                       HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                       Click="NextButton_Click"/>
                
                <Button Grid.Column="4" x:Name="FinishButton" 
                       Content="Complete Purchase" Width="150" Height="35"
                       Background="#A3BE8C" Foreground="White"
                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       IsVisible="False" Click="FinishButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>