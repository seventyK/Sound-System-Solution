<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
        Width="1280" Height="720"
        x:Class="SoundSystemSolutionTest.Dash"
        RequestedThemeVariant="Light"
        Title="Dashboard"
        ExtendClientAreaToDecorationsHint="True"
        Icon="/Assets/bicolsound_logo.ico">
    
    <Window.Styles>
        
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        
        <!-- Enhanced Tab Button Style -->
        <Style Selector="Button.TabButton">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="8 3"/>
            <Setter Property="Padding" Value="16 0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.1"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Hover State -->
        <Style Selector="Button.TabButton:pointerover">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Pressed State -->
        <Style Selector="Button.TabButton:pressed">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="9 4 7 2"/>
        </Style>

        <!-- Selected Tab Button Style -->
        <Style Selector="Button.TabButton.Selected">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#330d69" Offset="0.0" />
                    <GradientStop Color="#3d4283" Offset="0.5" />
                    <GradientStop Color="#285ce0" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
            <Setter Property="Effect">
                <DropShadowEffect Color="#285ce0" OffsetX="0" OffsetY="2" BlurRadius="8" Opacity="0.3"/>
            </Setter>
        </Style>

        <!-- Selected button hover state -->
        <Style Selector="Button.TabButton.Selected:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#3d1575" Offset="0.0" />
                    <GradientStop Color="#4a4d8f" Offset="0.5" />
                    <GradientStop Color="#3366ec" Offset="1.0" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto,*">
        
        <!-- Top Rectangle with Gradient -->
        <Rectangle Grid.Row="0" Height="30" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#330d69" Offset="0.0" />
                    <GradientStop Color="#3d4283" Offset="0.5" />
                    <GradientStop Color="#285ce0" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        
        <!-- Top Panel with Gradient -->
        <Grid Grid.Row="1" Height="55" ColumnDefinitions="Auto, Auto, *, Auto, Auto">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                    <GradientStop Color="#330d69" Offset="0.0" />
                    <GradientStop Color="#3d4283" Offset="0.5" />
                    <GradientStop Color="#285ce0" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            
            <TextBlock Grid.Column="0" 
                       Text="Bicol Sound" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       Padding="12 15 2 15"/>
            
            <TextBlock Grid.Column="1" 
                       Text=" | Rental Management System" 
                       FontSize="24" 
                       FontWeight="Light" 
                       Foreground="Azure" 
                       Padding="0 15 15 15"/>
            
            <TextBlock Grid.Column="2" 
                       Text="Hello, user" 
                       FontSize="15"
                       FontWeight="Light"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" 
                       Foreground="Azure"
                       Margin="0 9 15 0"/>
            
            <Button Grid.Column="3"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    ToolTip.Tip="Profile (in progress)"
                    Margin="0 -10 0 -12"
                    Padding="0 17 0 15">
                <Image Source="/Assets/dashboard_person.png" Width="60" Height="25"
                       RenderOptions.BitmapInterpolationMode="MediumQuality"/>
            </Button>
            
            <Button Grid.Column="4" x:Name="LogoutButton"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    ToolTip.Tip="Logout"
                    Margin="0 -10 0 -12"
                    Padding="0 17 0 15">
                <Image Source="/Assets/logout_icon.png" Width="60" Height="25"
                       RenderOptions.BitmapInterpolationMode="MediumQuality"/>
            </Button>
            
        </Grid>
        
        <!-- Main Content Area -->
        <Grid Grid.Row="2" ColumnDefinitions="225,*">
            
            <!-- Left Sidebar with Tabs -->
            <Border Grid.Column="0" Background="#F5F5F5" Padding="5">
                
                <StackPanel>
    
                    <TextBlock Text="Navigation"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#330d69"
                               Height="20"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="15 5 0 5"
                               Padding="8 0"/>

    
                    <!-- Horizontal line spacer -->
                    <Border Height="2" 
                            Margin="8 2 6 5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                <GradientStop Color="#330d69" Offset="0.0" />
                                <GradientStop Color="#3d4283" Offset="0.5" />
                                <GradientStop Color="#285ce0" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" OffsetX="0" OffsetY="1" BlurRadius="2" Opacity="0.3"/>
                        </Border.Effect>
                    </Border>



                    
                    <Button x:Name="Tab1Button" 
                            Content="Welcome" 
                            Classes="TabButton Selected"
                            Click="OnTabButtonClick"/>
                    
                    <Button x:Name="Tab2Button" 
                            Content="Transactions" 
                            Classes="TabButton"
                            Click="OnTabButtonClick"/>
                    
                    <Button x:Name="Tab3Button" 
                            Content="Active Rentals" 
                            Classes="TabButton"
                            Click="OnTabButtonClick"/>
                    
                    <Button x:Name="Tab4Button"
                            Content="Due Payments"
                            Classes="TabButton"
                            Click="OnTabButtonClick"/>
                    
                    <Button x:Name="Tab5Button"
                            Content="Inventory"
                            Classes="TabButton"
                            Click="OnTabButtonClick"/>
                    
                </StackPanel>
                
            </Border>
            
            <!-- Right Content Panel -->
            <Border Grid.Column="1" Padding="10" Background="White">
               
                <ContentControl x:Name="ContentArea">
                    
                    <!-- Default content for Tab 1 -->
                    <Panel x:Name="Tab1Content">
                       
                        <TextBlock Text="Content 1" 
                                   FontSize="20" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        
                    </Panel>
                    
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>